# =============================================================================
# env.sh — Kolla-Ansible 멀티노드 (controller 1 + compute N) 환경값
#   cp env.example env.sh 후 필요한 것만 바꾼다. env.sh 는 git에 올리지 않는다(.gitignore).
#   사이트별 값은 sites/<이름>.env 에 두고 뒤에 덧붙인다 (뒤에 온 값이 이김):
#       cp env.example env.sh && cat sites/su-cloud.env >> env.sh
#
#   비워 둔 값은 스크립트가 탐색한다. 탐색 결과는 10-deployer.sh 가 .state 에 저장하고
#   20/30 이 읽는다. 먼저 보고 싶으면:  ./10-deployer.sh --discover <compute IP> [...]
#
#   IP는 어디에도 적지 않는다. OS 설치 때 고정 IP로 잡고:
#     controller IP/NIC/DNS : 10-deployer.sh 가 controller에서 감지
#     compute IP            : ./10-deployer.sh 인자 (여러 대 가능)
#     compute NIC/호스트명    : 10-deployer.sh 가 SSH로 감지
# =============================================================================

# ---- 노드 (비우면 탐색) ---------------------------------------------------
CTRL_HOST=""                      # 비우면 controller의 현재 hostname. 채우면 00이 이 이름으로 바꾸고 10이 확인
CTRL_IF=""                        # 관리 NIC. 비우면 기본 라우트 NIC
COMP_IF=""                        # 모든 compute에 같은 NIC 이름을 강제할 때만. 비우면 노드별 기본 라우트 NIC
CTRL_IS_COMPUTE="no"              # yes면 controller도 nova-compute 실행

# ---- 보호 IP (선택) --------------------------------------------------------
# 어떤 노드든 관리 IP가 이 중 하나면 모든 스크립트가 즉시 중단 (공백 구분). 비우면 검사 안 함.
PROTECTED_IPS=""

# ---- OS ------------------------------------------------------------------
NODE_USER=""                      # 모든 노드에 같은 이름으로 있어야 하는 배포 유저. 비우면 controller의 현재 유저
TIMEZONE=""                       # 예: Asia/Seoul. 비우면 설치 때 값 그대로

# ---- Kolla ---------------------------------------------------------------
KOLLA_VERSION="22.0.0"
ANSIBLE_CORE_VERSION="2.19.11"
VENV="$HOME/kolla-venv"
KOLLA_DIR="/etc/kolla"
NEUTRON_PLUGIN="ovn"
HORIZON_PORT="80"
EXTERNAL_FQDN=""                  # 채우면 Horizon/public 엔드포인트가 이 이름으로 (haproxy 없이 미검증)

# ---- Neutron 외부망 (controller 안의 가상망, br-ex ← veth) ------------------
# 호스트 LAN과 겹치면 10-deployer.sh 가 중단한다 — 겹치면 다른 사설 대역으로.
EXT_IF="veth1"                    # neutron_external_interface (br-ex 편입)
EXT_IF_PEER="veth0"               # UP만, 어디에도 미부착
EXT_CIDR="192.168.200.0/24"
EXT_GW="192.168.200.1"            # br-ex IP = provider_subnet 게이트웨이
EXT_ROUTER_IP="192.168.200.2"     # tenant_router 외부 포트 (명시 — 미지정 시 FIP 풀 잠식)
EXT_POOL_START="192.168.200.101"
EXT_POOL_END="192.168.200.150"

# ---- 테넌트망 / 테스트 리소스 ---------------------------------------------
TENANT_CIDR="10.10.10.0/24"
TENANT_DNS=""                     # 비우면 controller 관리 NIC의 DNS (못 찾으면 8.8.8.8)
CIRROS_VER="0.6.3"

# ---- VM 격리 (30-init.sh, controller iptables) ------------------------------
ISOLATE_VMS="yes"                 # no면 격리 규칙을 넣지 않음 (이미 있으면 제거)
ISOLATE_EXTRA_CIDRS="100.64.0.0/10"   # 관리 대역 외에 VM → FORWARD DROP 할 대역 (공백 구분). 기본 = Tailscale
