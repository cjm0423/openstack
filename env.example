# =============================================================================
# env.sh — SU-Cloud 개발계 멀티노드 (controller + compute) 환경값
#   cp env.example env.sh 로 복사한 뒤 값을 채운다. env.sh는 git에 올리지 않는다(.gitignore).
#   모든 스크립트가 이 파일 하나만 읽는다. 여기 없는 값은 스크립트가 바꾸지 않는다.
# =============================================================================

# ---- 노드 ----------------------------------------------------------------
# 호스트명은 두 노드에서 실제 hostname으로 설정되고(00-node-prep --role), 인벤토리 이름으로도 쓰인다.
# IP는 여기 적지 않는다. OS 설치 때 고정 IP로 잡고, 스크립트가 NIC에서 읽는다.
#   controller IP/NIC : 10-deployer.sh 가 감지    compute IP : ./10-deployer.sh <compute IP> 인자
#   확정값은 10-deployer.sh 가 .state 에 저장 (git 제외) → 20/30 이 읽음
CTRL_HOST="su-cloud-ctrl"         # ThinkCentre (기존 개발계, 밀고 재설치)
CTRL_IF=""                        # 관리 NIC. 비우면 기본 라우트 NIC 자동 감지 (예: enp7s0f0)

COMP_HOST="su-cloud-cmp1"         # 새 P520 (X550-T2 듀얼포트 — 포트 하나만 씀)
COMP_IF=""                        # 비우면 compute의 기본 라우트 NIC 자동 감지

CTRL_IS_COMPUTE="no"              # yes면 controller도 nova-compute 실행 (하이퍼바이저 2대)

# ---- 운영계 보호 ---------------------------------------------------------
# 어떤 노드든 관리 IP가 이 중 하나면 모든 스크립트가 즉시 중단 (공백 구분)
PROTECTED_IPS="210.94.240.179 210.94.240.181"

# ---- SSH / 배포 유저 (두 노드에 같은 이름으로 존재해야 함, sudo 가능) ----
NODE_USER="ubuntu"

# ---- Kolla ---------------------------------------------------------------
KOLLA_VERSION="22.0.0"
ANSIBLE_CORE_VERSION="2.19.11"
VENV="$HOME/kolla-venv"
KOLLA_DIR="/etc/kolla"
NEUTRON_PLUGIN="ovn"              # 운영계와 동일. (스터디는 openvswitch)
HORIZON_PORT="80"                 # 나중에 nginx가 80을 써야 하면 8080 등으로
EXTERNAL_FQDN=""                  # 예: su-cloud-dev.com — 채우면 Horizon/public 엔드포인트가 이 이름으로 (haproxy 없이도 동작하나 SU-Cloud 미검증)

# ---- Neutron 외부망 (controller의 br-ex — 운영계 값 그대로) ----------------
EXT_IF="veth1"                    # neutron_external_interface (br-ex 편입)
EXT_IF_PEER="veth0"               # UP만, 어디에도 미부착 (운영계 함정 5)
EXT_CIDR="192.168.200.0/24"
EXT_GW="192.168.200.1"            # br-ex IP = provider_subnet 게이트웨이
EXT_ROUTER_IP="192.168.200.2"     # tenant_router 외부 포트 (명시 — 미지정 시 FIP 풀 잠식)
EXT_POOL_START="192.168.200.101"
EXT_POOL_END="192.168.200.150"
TENANT_CIDR="10.10.10.0/24"
TENANT_DNS="8.8.8.8"
CIRROS_VER="0.6.3"
